---
import WaveMark from './WaveMark.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const links = [
  { href: '/at-home/', label: 'At Home' },
  { href: '/benefits/', label: 'Benefits' },
  { href: '/events-business/', label: 'Events & Business' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const legal = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <WaveMark size={32} class="footer-mark" />
      <p class="wordmark">Onda Ritual</p>
      <p class="tagline">Natural rituals. Brighter days.</p>
      <p class="beats beats--on-dark">Heat / Cold / Restore</p>
      <div class="footer-social">
        <a href="#" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href="#" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="footer-contact">
      <a href="mailto:hello@ondaritual.co.uk">hello@ondaritual.co.uk</a>
      <a href="tel:+441234567890">+44 (0) 1234 567 890</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {year} Onda Ritual</p>
    <div class="footer-legal">
      {legal.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-sand);
    padding-block: 4rem 1.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(232, 228, 221, 0.15);
  }

  .footer-brand :global(.footer-mark) {
    color: var(--color-stone);
    margin-bottom: 0.8rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-stone);
    margin: 0 0 0.3rem;
  }

  .tagline {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
  }

  .footer-social {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.2rem;
  }

  .footer-social a {
    color: var(--color-sand);
  }

  .footer-social a:hover {
    color: var(--color-stone);
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.82rem;
  }

  .footer-nav a,
  .footer-contact a {
    text-decoration: none;
    color: var(--color-sand);
  }

  .footer-nav a:hover,
  .footer-contact a:hover {
    color: var(--color-stone);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.82rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: 1.5rem;
    font-size: 0.75rem;
    color: #8a8578;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 1.2rem;
  }

  .footer-legal a {
    text-decoration: none;
    color: #8a8578;
  }

  .footer-legal a:hover {
    color: var(--color-sand);
  }
</style>
