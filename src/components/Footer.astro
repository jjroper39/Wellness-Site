---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="wordmark">Onda Ritual</p>
    <p class="tagline">Slow rituals for a steadier life.</p>
    <p class="meta">&copy; {year} Onda Ritual. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg-alt);
    padding-block: 3rem;
    text-align: center;
    color: var(--color-ink-soft);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
  }

  .tagline {
    margin-bottom: 1.2rem;
  }

  .meta {
    font-size: 0.82rem;
    margin: 0;
  }
</style>
