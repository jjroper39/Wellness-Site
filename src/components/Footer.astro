---
import LogoMark from './LogoMark.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();

const links = [
  { href: '/services/', label: 'Services' },
  { href: '/domestic/', label: 'Domestic' },
  { href: '/commercial/', label: 'Commercial' },
  { href: '/maintenance/', label: 'Maintenance' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const legal = [
  { href: '/privacy/', label: 'Privacy' },
  { href: '/terms/', label: 'Terms' },
];
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <a href="/" class="wordmark">
        <LogoMark size={30} />
        <span class="wordmark-text">VERTEX<span class="wordmark-climate">CLIMATE</span></span>
      </a>
      <p class="tagline">Comfort. Engineered.</p>
      <div class="footer-social">
        <a href="#" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
        <a href="#" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <p class="footer-heading">Site</p>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="footer-contact">
      <p class="footer-heading">Contact</p>
      <p><Icon name="phone" size={15} /><span class="tbd">[VERTEX PHONE]</span></p>
      <p class="footer-email tbd">[VERTEX EMAIL]</p>
      <p><Icon name="map-pin" size={15} /><span class="tbd">[SERVICE AREA]</span></p>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {year} Vertex Climate. <span class="tbd">[Company number]</span></p>
    <div class="footer-legal">
      {legal.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #c3d0e0;
    padding-block: 4rem 1.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .wordmark-climate {
    color: var(--orange);
  }

  .tagline {
    margin: 0 0 1.2rem;
    font-size: 0.9rem;
  }

  .footer-social {
    display: flex;
    gap: 0.9rem;
  }

  .footer-social a {
    color: #c3d0e0;
  }

  .footer-social a:hover {
    color: #fff;
  }

  .footer-heading {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: #7f93ab;
    margin: 0 0 1rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .footer-nav a,
  .footer-contact a {
    text-decoration: none;
    color: #c3d0e0;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .footer-contact p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .footer-email {
    padding-left: 1.6rem;
  }

  .tbd {
    color: #ffb385;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    padding-top: 1.5rem;
    font-size: 0.78rem;
    color: #7f93ab;
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 1.2rem;
  }

  .footer-legal a {
    text-decoration: none;
    color: #7f93ab;
  }

  .footer-legal a:hover {
    color: #c3d0e0;
  }
</style>
