---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="1.4" />
  <path
    d="M10 32c6-11 16-11 22 0s16 11 22 0"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    fill="none"
  />
</svg>
