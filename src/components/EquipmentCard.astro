---
import ImagePlaceholder from './ImagePlaceholder.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  name: string;
  price: string;
  imageAlt: string;
  imageVariant?: 'warm' | 'cool' | 'dark' | 'stone';
  href: string;
}

const { name, price, imageAlt, imageVariant = 'warm', href } = Astro.props;
---

<article class="equipment-card reveal">
  <ImagePlaceholder alt={imageAlt} variant={imageVariant} ratio="4 / 3" />
  <div class="equipment-card-body">
    <h3>{name}</h3>
    <p class="equipment-card-price">{price}</p>
    <p class="equipment-card-copy"><slot /></p>
    <CTAButton href={href}>View Details</CTAButton>
  </div>
</article>

<style>
  .equipment-card {
    border: 1px solid var(--color-line);
    background: var(--color-ivory);
    display: flex;
    flex-direction: column;
  }

  .equipment-card-body {
    padding: 1.75rem;
  }

  .equipment-card-price {
    color: var(--color-ember);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .equipment-card-copy {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }
</style>
