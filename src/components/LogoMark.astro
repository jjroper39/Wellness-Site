---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<img
  src="/vertex-logo.png"
  alt="Vertex Climate"
  width={size}
  height={size}
  class={className}
  style={`width: ${size}px; height: ${size}px; object-fit: contain;`}
/>
