---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  label: string;
  onDark?: boolean;
  class?: string;
}

const { icon, label, onDark = false, class: className = '' } = Astro.props;
---

<div class={`feature-icon ${onDark ? 'feature-icon--on-dark' : ''} ${className}`}>
  <span class="feature-icon-badge">
    <Icon name={icon as any} size={24} />
  </span>
  <h3>{label}</h3>
  <p><slot /></p>
</div>

<style>
  .feature-icon {
    max-width: 18rem;
  }

  .feature-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    background: var(--ice);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .feature-icon--on-dark .feature-icon-badge {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .feature-icon h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .feature-icon--on-dark h3 {
    color: #fff;
  }

  .feature-icon p {
    font-size: 0.94rem;
    color: var(--mid-grey);
    margin: 0;
  }

  .feature-icon--on-dark p {
    color: #c3d0e0;
  }
</style>
