---
const interestOptions = [
  'At-home rental',
  'Private event',
  'Corporate event',
  'Business leasing',
  'Try Before You Buy',
  'Not sure yet',
];

const equipmentOptions = ['Sauna', 'Cold plunge', 'Wood-fired hot tub', 'Full package', 'Not sure'];
---

<form class="enquiry-form" id="enquiry-form" novalidate>
  <fieldset class="form-field">
    <legend>1. What are you interested in?</legend>
    <div class="chip-group" data-chip-group="interest">
      {interestOptions.map((opt) => (
        <button type="button" class="chip" data-value={opt}>{opt}</button>
      ))}
    </div>
    <input type="hidden" name="interest" id="interest-input" required />
  </fieldset>

  <fieldset class="form-field">
    <legend>2. What would you like?</legend>
    <div class="chip-group" data-chip-group="equipment">
      {equipmentOptions.map((opt) => (
        <button type="button" class="chip" data-value={opt}>{opt}</button>
      ))}
    </div>
    <input type="hidden" name="equipment" id="equipment-input" required />
  </fieldset>

  <div class="form-grid">
    <label class="form-field">
      <span>3. Preferred dates / rental period</span>
      <input type="text" name="dates" placeholder="e.g. a weekend in June" />
    </label>

    <label class="form-field">
      <span>4. Postcode / location</span>
      <input type="text" name="location" placeholder="e.g. SW1A 1AA" required />
    </label>

    <label class="form-field">
      <span>5. Name</span>
      <input type="text" name="name" required />
    </label>

    <label class="form-field">
      <span>6. Email</span>
      <input type="email" name="email" required />
    </label>

    <label class="form-field">
      <span>7. Phone <em>(optional)</em></span>
      <input type="tel" name="phone" />
    </label>
  </div>

  <label class="form-field">
    <span>8. Tell us about what you have in mind</span>
    <textarea name="details" rows="4"></textarea>
  </label>

  <button type="submit" class="btn btn--solid enquiry-submit">Send Enquiry</button>
  <p class="form-note">
    Sending opens your email client with your answers pre-filled, addressed to
    hello@ondaritual.co.uk — nothing is sent until you press send there.
  </p>
</form>

<div class="enquiry-success" id="enquiry-success" hidden>
  <p class="eyebrow">Thank you</p>
  <h3>Your enquiry is ready to send.</h3>
  <p>
    We've opened your email client with your details filled in. Just hit
    send there and we'll be in touch shortly.
  </p>
</div>

<style>
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
    max-width: 40rem;
  }

  .form-field {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .form-field legend,
  .form-field > span {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-soft);
    padding: 0;
  }

  .form-field em {
    text-transform: none;
    letter-spacing: normal;
    font-style: italic;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    padding: 0.6rem 1.1rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    border-radius: 2px;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .chip:hover {
    border-color: var(--color-ember);
  }

  .chip.is-selected {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-stone);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 1.5rem;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--color-ember);
    outline-offset: 1px;
  }

  .enquiry-submit {
    align-self: flex-start;
  }

  .form-note {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    max-width: 30rem;
    margin: -1.2rem 0 0;
  }

  .enquiry-success {
    max-width: 34rem;
    padding: 2rem;
    border: 1px solid var(--color-line);
    background: var(--color-ivory);
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('enquiry-form');
  const success = document.getElementById('enquiry-success');

  document.querySelectorAll('[data-chip-group]').forEach((group) => {
    const inputId = `${group.getAttribute('data-chip-group')}-input`;
    const hiddenInput = document.getElementById(inputId);
    group.querySelectorAll('.chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        group.querySelectorAll('.chip').forEach((c) => c.classList.remove('is-selected'));
        chip.classList.add('is-selected');
        if (hiddenInput) hiddenInput.value = chip.getAttribute('data-value') || '';
      });
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const email = String(data.get('email') || '').trim();
    const interest = String(data.get('interest') || '').trim();
    const equipment = String(data.get('equipment') || '').trim();
    const location = String(data.get('location') || '').trim();

    if (!name || !email || !interest || !equipment || !location) {
      form.reportValidity();
      return;
    }

    const lines = [
      `Interested in: ${interest}`,
      `Would like: ${equipment}`,
      `Preferred dates / rental period: ${data.get('dates') || '—'}`,
      `Postcode / location: ${location}`,
      `Name: ${name}`,
      `Email: ${email}`,
      `Phone: ${data.get('phone') || '—'}`,
      '',
      'Details:',
      String(data.get('details') || '—'),
    ];

    const subject = encodeURIComponent('Onda Ritual enquiry');
    const body = encodeURIComponent(lines.join('\n'));
    window.location.href = `mailto:hello@ondaritual.co.uk?subject=${subject}&body=${body}`;

    form.hidden = true;
    if (success) success.hidden = false;
  });
</script>
