---
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M8 39L22.5 13"
    stroke="#23679B"
    stroke-width="6"
    stroke-linecap="square"
  />
  <path
    d="M25.5 13L40 39"
    stroke="#E55D0D"
    stroke-width="6"
    stroke-linecap="square"
  />
</svg>
