---
interface Item {
  quote: string;
  name: string;
}

interface Props {
  items?: Item[];
}

const {
  items = [
    { quote: 'Add a genuine customer review here once available.', name: 'Customer name / location' },
    { quote: 'Add a genuine customer review here once available.', name: 'Customer name / location' },
    { quote: 'Add a genuine customer review here once available.', name: 'Customer name / location' },
  ],
} = Astro.props;
---

<div class="testimonial-grid">
  {items.map((item) => (
    <figure class="testimonial-card card reveal">
      <blockquote>&ldquo;{item.quote}&rdquo;</blockquote>
      <figcaption>{item.name}</figcaption>
    </figure>
  ))}
</div>

<style>
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .testimonial-card {
    padding: 2rem;
    margin: 0;
  }

  .testimonial-card blockquote {
    font-size: 1.02rem;
    margin: 0 0 1.2rem;
    color: var(--charcoal);
  }

  .testimonial-card figcaption {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    color: var(--mid-grey);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
