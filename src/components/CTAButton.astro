---
interface Props {
  href: string;
  variant?: 'primary' | 'navy' | 'outline';
  onDark?: boolean;
  class?: string;
}

const { href, variant = 'primary', onDark = false, class: className = '' } = Astro.props;

const classes = [
  'btn',
  variant === 'navy' && 'btn--navy',
  variant === 'outline' && 'btn--outline',
  onDark && 'btn--on-dark',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes}>
  <slot />
</a>
