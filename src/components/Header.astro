---
import LogoMark from './LogoMark.astro';
import CTAButton from './CTAButton.astro';
import Icon from './Icon.astro';

const navItems = [
  { href: '/services/', label: 'Services' },
  { href: '/domestic/', label: 'Domestic' },
  { href: '/commercial/', label: 'Commercial' },
  { href: '/maintenance/', label: 'Maintenance' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a href="/" class="wordmark">
      <LogoMark size={30} />
      <span class="wordmark-text">
        <span class="wordmark-vertex">VERTEX</span><span class="wordmark-climate">CLIMATE</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="#" class="header-phone">
        <Icon name="phone" size={16} />
        <span class="tbd-inline">[VERTEX PHONE]</span>
      </a>
      <CTAButton href="/contact/" class="header-cta">Get a Quote</CTAButton>
      <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-top wrap">
      <a href="/" class="wordmark">
        <LogoMark size={28} />
        <span class="wordmark-text">
          <span class="wordmark-vertex">VERTEX</span><span class="wordmark-climate">CLIMATE</span>
        </span>
      </a>
      <button class="nav-toggle" id="nav-close" aria-label="Close menu">
        <Icon name="close" size={24} />
      </button>
    </div>
    <nav class="wrap" aria-label="Mobile">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <p class="mobile-nav-phone">
        <Icon name="phone" size={16} />
        <span class="tbd-inline">[VERTEX PHONE]</span>
      </p>
      <CTAButton href="/contact/" class="mobile-nav-cta">Get a Quote</CTAButton>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: transparent;
    color: #fff;
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: #fff;
    border-bottom-color: var(--line);
    color: var(--charcoal);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .wordmark-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }

  .wordmark-vertex {
    color: inherit;
  }

  .wordmark-climate {
    color: var(--orange);
  }

  .site-header.is-scrolled .wordmark-vertex {
    color: var(--navy);
  }

  .nav-desktop ul {
    list-style: none;
    display: flex;
    gap: 1.9rem;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: inherit;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .nav-desktop a:hover,
  .nav-desktop a[aria-current='page'] {
    border-bottom-color: var(--orange);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .header-phone {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .tbd-inline {
    color: var(--orange);
  }

  .site-header.is-scrolled .header-phone {
    color: var(--navy);
  }

  .header-actions :global(.header-cta) {
    min-height: 42px;
    padding: 0 1.3rem;
    font-size: 0.85rem;
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    padding: 0.2rem;
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    background: var(--navy);
    color: #fff;
    z-index: 60;
    transform: translateX(100%);
    transition: transform 0.35s var(--ease);
    overflow-y: auto;
  }

  .mobile-nav.is-open {
    transform: translateX(0);
  }

  .mobile-nav-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
  }

  .mobile-nav-top .wordmark-vertex {
    color: #fff;
  }

  .mobile-nav nav {
    padding-top: 2.5rem;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .mobile-nav a {
    text-decoration: none;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.5rem;
  }

  .mobile-nav-phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 1.6rem;
  }

  @media (max-width: 960px) {
    .nav-desktop,
    .header-actions :global(.header-cta),
    .header-phone {
      display: none;
    }

    .nav-toggle {
      display: block;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('nav-close');
  const mobileNav = document.getElementById('mobile-nav');

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const openNav = () => {
    mobileNav?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };

  const closeNav = () => {
    mobileNav?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openNav);
  closeBtn?.addEventListener('click', closeNav);
  mobileNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeNav));
</script>
