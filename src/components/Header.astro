---
import WaveMark from './WaveMark.astro';

const navItems = [
  { href: '#experiences', label: 'Experiences' },
  { href: '#wellness-anywhere', label: 'Wellness Anywhere' },
  { href: '#benefits', label: 'Benefits' },
  { href: '#contact', label: 'Enquire' },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#home" class="wordmark">
      <WaveMark size={30} />
      <span class="wordmark-text">
        <span class="wordmark-onda">Onda</span>
        <span class="wordmark-ritual">Ritual</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-charcoal);
    color: var(--color-stone);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-stone);
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-family: var(--font-display);
  }

  .wordmark-onda {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }

  .wordmark-ritual {
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    color: var(--color-sand);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-sand);
  }

  nav a:hover {
    color: var(--color-stone);
  }

  @media (max-width: 720px) {
    .header-inner {
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      padding-block: 1.2rem;
    }
    nav ul {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.9rem 1.2rem;
    }
    nav a {
      font-size: 0.68rem;
    }
  }
</style>
