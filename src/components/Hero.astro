---
interface Props {
  eyebrow?: string;
  heading: string;
  copy?: string;
  imageAlt: string;
  imageSrc?: string;
  imageVariant?: 'navy' | 'blue' | 'orange' | 'ice';
  height?: 'full' | 'tall';
}

const {
  eyebrow,
  heading,
  copy,
  imageAlt,
  imageSrc,
  imageVariant = 'navy',
  height = 'tall',
} = Astro.props;
---

<section class={`hero hero--${height}`} aria-label={imageAlt}>
  {imageSrc ? (
    <img src={imageSrc} alt="" class="hero-bg hero-bg-photo" fetchpriority="high" />
  ) : (
    <div class={`hero-bg img-placeholder img-placeholder--${imageVariant}`} role="img" aria-label={imageAlt}></div>
  )}
  <div class="hero-overlay"></div>
  <div class="wrap hero-inner">
    {eyebrow && <p class="eyebrow eyebrow--on-dark">{eyebrow}</p>}
    <h1 set:html={heading} class="reveal is-visible" />
    {copy && <p class="hero-copy">{copy}</p>}
    <div class="btn-row hero-actions">
      <slot />
    </div>
  </div>
  <div class="hero-cut" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;
  }

  .hero--full {
    min-height: 88vh;
  }

  .hero--tall {
    min-height: 56vh;
    padding-top: 5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-bg-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(8, 26, 56, 0.82) 0%, rgba(8, 42, 85, 0.62) 45%, rgba(8, 42, 85, 0.35) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-block: 7.5rem 5rem;
  }

  .hero-inner h1 {
    color: #fff;
    font-size: clamp(2.3rem, 6vw, 4rem);
    margin-bottom: 0.5rem;
  }

  .hero-copy {
    font-family: var(--font-body);
    text-transform: none;
    font-size: 1.08rem;
    color: #dce6f0;
    max-width: 32rem;
  }

  .hero-actions {
    margin-top: 1rem;
  }

  .hero-cut {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 4.5rem;
    background: var(--off-white);
    clip-path: polygon(0 100%, 100% 40%, 100% 100%);
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 6rem 3.5rem;
    }

    .hero-cut {
      height: 2.5rem;
    }
  }
</style>
