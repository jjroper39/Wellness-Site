---
import WaveMark from './WaveMark.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  copy?: string;
  imageAlt: string;
  imageVariant?: 'warm' | 'cool' | 'dark' | 'stone';
  height?: 'full' | 'tall';
  showMark?: boolean;
}

const {
  eyebrow,
  heading,
  copy,
  imageAlt,
  imageVariant = 'dark',
  height = 'full',
  showMark = false,
} = Astro.props;
---

<section class={`hero hero--${height}`} aria-label={imageAlt}>
  <div class={`hero-bg img-placeholder img-placeholder--${imageVariant}`} role="img" aria-label={imageAlt}></div>
  <div class="hero-overlay"></div>
  <div class="wrap hero-inner">
    {showMark && <WaveMark size={56} class="hero-mark" />}
    <h1 set:html={heading} class="reveal is-visible" />
    {copy && <p class="hero-copy">{copy}</p>}
    <div class="btn-row hero-actions">
      <slot />
    </div>
    {eyebrow && <p class="beats beats--on-dark hero-beats">{eyebrow}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--color-stone);
    overflow: hidden;
  }

  .hero--full {
    min-height: 92vh;
  }

  .hero--tall {
    min-height: 62vh;
    padding-top: 5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 15, 0.55) 0%, rgba(20, 20, 15, 0.35) 45%, rgba(20, 20, 15, 0.75) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-block: 8rem 4rem;
  }

  .hero-inner :global(.hero-mark) {
    color: var(--color-sand);
    margin-bottom: 0.6rem;
  }

  .hero-inner h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-bottom: 0.6rem;
  }

  .hero-copy {
    font-size: 1.08rem;
    color: #ece8df;
    max-width: 32rem;
  }

  .hero-actions {
    margin-top: 1rem;
  }

  .hero-beats {
    margin-top: 2.5rem;
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 6.5rem 3rem;
    }
  }
</style>
