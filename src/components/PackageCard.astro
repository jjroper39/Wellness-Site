---
import CTAButton from './CTAButton.astro';

interface Props {
  name: string;
  combo: string;
  href: string;
  ctaLabel?: string;
  featured?: boolean;
}

const { name, combo, href, ctaLabel = 'Explore', featured = false } = Astro.props;
---

<article class={`package-card reveal ${featured ? 'package-card--featured' : ''}`}>
  <p class="package-card-combo">{combo}</p>
  <h3>{name}</h3>
  <p class="package-card-copy"><slot /></p>
  <CTAButton href={href} variant={featured ? 'ember' : 'outline'}>{ctaLabel}</CTAButton>
</article>

<style>
  .package-card {
    border: 1px solid var(--color-line);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .package-card--featured {
    border-color: var(--color-ember);
  }

  .package-card-combo {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: var(--color-ember);
    margin: 0 0 0.6rem;
  }

  .package-card-copy {
    color: var(--color-ink-soft);
    margin-bottom: 1.4rem;
  }

  .package-card .btn {
    align-self: flex-start;
    margin-top: auto;
  }
</style>
