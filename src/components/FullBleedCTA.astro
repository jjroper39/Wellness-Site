---
import ApexMark from './ApexMark.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  showMark?: boolean;
}

const { eyebrow, heading, subheading, showMark = true } = Astro.props;
---

<section class="full-bleed-cta section--navy vertex-cut">
  <div class="wrap full-bleed-cta-inner reveal">
    {showMark && <ApexMark size={40} class="full-bleed-cta-mark" />}
    {eyebrow && <p class="eyebrow eyebrow--on-dark">{eyebrow}</p>}
    <h2 set:html={heading} />
    {subheading && <p class="full-bleed-cta-sub">{subheading}</p>}
    <div class="btn-row full-bleed-cta-actions">
      <slot />
    </div>
  </div>
</section>

<style>
  .full-bleed-cta {
    padding-block: 5.5rem 6.5rem;
  }

  .full-bleed-cta-inner {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .full-bleed-cta-mark {
    margin-bottom: 0.6rem;
  }

  .full-bleed-cta h2 {
    font-size: clamp(2rem, 5vw, 2.9rem);
  }

  .full-bleed-cta-sub {
    color: #c3d0e0;
    font-size: 1.05rem;
  }

  .full-bleed-cta-actions {
    justify-content: center;
    margin-top: 1.2rem;
  }
</style>
