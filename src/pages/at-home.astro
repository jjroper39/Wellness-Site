---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import EquipmentCard from '../components/EquipmentCard.astro';
import PackageCard from '../components/PackageCard.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import Testimonial from '../components/Testimonial.astro';

const steps = [
  { number: '01', title: 'Choose', copy: 'Choose your equipment and rental period.' },
  { number: '02', title: 'Deliver', copy: 'We arrange delivery to your home.' },
  { number: '03', title: 'Set Up', copy: "We'll get everything positioned and ready." },
  { number: '04', title: 'Ritual', copy: 'Heat. Cold. Rest. Repeat.' },
  { number: '05', title: 'Collect', copy: "When your rental ends, we'll come back and take care of the rest." },
];

const equipment = [
  {
    name: 'Cold Plunge',
    imageAlt: 'A minimalist cold plunge tub set on a garden patio',
    variant: 'cool' as const,
    copy: 'Bring cold immersion into your daily routine without committing to buying your own plunge. Ideal for morning routines, post-training recovery or simply trying cold exposure for yourself.',
  },
  {
    name: 'Wood-Fired Hot Tub',
    imageAlt: 'A wood-fired hot tub with fire glowing beneath it at dusk',
    variant: 'warm' as const,
    copy: 'Real fire. Hot water. No permanent installation. Create the perfect evening with a traditional wood-fired hot tub delivered directly to your home. Perfect for weekends, birthdays, celebrations and longer stays.',
  },
  {
    name: 'Sauna',
    imageAlt: 'A private timber sauna a few steps from a back door',
    variant: 'dark' as const,
    copy: 'Your own private sauna, steps from your back door. Enjoy it on its own or pair it with a cold plunge to create the complete Onda experience.',
  },
];

const packages = [
  {
    name: 'The Reset',
    combo: 'Cold Plunge + Sauna',
    copy: 'The complete hot-and-cold ritual. Heat. Plunge. Rest. Repeat.',
    ctaLabel: 'Explore',
  },
  {
    name: 'The Escape',
    combo: 'Sauna + Wood-Fired Hot Tub',
    copy: 'Slow things down. Perfect for weekends away, celebrations and evenings with friends.',
    ctaLabel: 'Explore',
  },
  {
    name: 'The Full Ritual',
    combo: 'Sauna + Cold Plunge + Wood-Fired Hot Tub',
    copy: 'Why choose? Turn your outdoor space into a complete private wellness retreat.',
    ctaLabel: 'Get a Quote',
    featured: true,
  },
];
---

<Layout
  title="At-Home Rentals"
  description="Rent premium saunas, cold plunges and wood-fired hot tubs for your home. Delivered, set up and ready to enjoy for a weekend, a month or longer."
>
  <Hero
    heading="The spa.<br />At yours."
    copy="Transform your garden into your own private wellness retreat. Rent premium saunas, cold plunges and wood-fired hot tubs for a weekend, a month or longer."
    imageAlt="A premium home garden wellness setup with sauna and hot tub"
    imageVariant="warm"
  >
    <CTAButton href="/contact/" variant="solid" onDark={true}>Build Your Package</CTAButton>
  </Hero>

  <section class="section--ivory how-it-works">
    <div class="wrap">
      <SectionHeading
        eyebrow="How it works"
        heading="Wellness, without the commitment."
        lede="You don't need to spend thousands creating a permanent home spa. We'll bring it to you."
      />
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <section id="equipment" class="section--sand equipment-section">
    <div class="wrap">
      <SectionHeading heading="Choose your ritual." />
      <div class="equipment-grid">
        {equipment.map((item) => (
          <EquipmentCard
            name={item.name}
            price="From £___"
            imageAlt={item.imageAlt}
            imageVariant={item.variant}
            href="/contact/"
          >
            {item.copy}
          </EquipmentCard>
        ))}
      </div>
    </div>
  </section>

  <section id="packages" class="section--ivory packages-section">
    <div class="wrap">
      <SectionHeading heading="Better together." />
      <div class="packages-grid">
        {packages.map((pkg) => (
          <PackageCard name={pkg.name} combo={pkg.combo} href="/contact/" ctaLabel={pkg.ctaLabel} featured={pkg.featured}>
            {pkg.copy}
          </PackageCard>
        ))}
      </div>
    </div>
  </section>

  <section class="rental-length">
    <ImagePlaceholder
      alt="A tranquil garden wellness setting through changing seasons"
      variant="cool"
      ratio="21 / 9"
      class="rental-length-image"
    />
    <div class="wrap rental-length-inner reveal">
      <h2>A weekend.<br />A month.<br />A season.</h2>
      <p>Your ritual doesn't have to be permanent.</p>
      <p>
        Choose the rental period that works for you, from short experiences
        and special occasions to longer-term wellness setups.
      </p>
      <p>Want to keep it? Talk to us about longer-term options.</p>
      <CTAButton href="/contact/" variant="solid" onDark={true}>Get a Quote</CTAButton>
    </div>
  </section>

  <section class="section--ivory testimonial-section">
    <div class="wrap">
      <SectionHeading heading="What people are saying." />
      <Testimonial />
    </div>
  </section>
</Layout>

<style>
  .equipment-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 2.8rem;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 2.8rem;
  }

  .rental-length {
    position: relative;
    color: var(--color-stone);
    display: flex;
    align-items: center;
    min-height: 32rem;
  }

  .rental-length :global(.rental-length-image) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .rental-length::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 15, 0.35), rgba(20, 20, 15, 0.75));
  }

  .rental-length-inner {
    position: relative;
    z-index: 1;
    max-width: 30rem;
  }

  .rental-length-inner h2 {
    font-size: clamp(2rem, 5vw, 2.9rem);
  }

  @media (max-width: 900px) {
    .equipment-grid,
    .packages-grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }
  }
</style>
