---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTAButton from '../components/CTAButton.astro';
import EditorialSplit from '../components/EditorialSplit.astro';
import FeatureIcon from '../components/FeatureIcon.astro';

const modules = [
  {
    id: 'cold-plunge',
    eyebrow: 'Cold',
    heading: 'Awaken. Reset. Renew.',
    alt: 'A cold plunge pool in a beautiful garden setting',
    variant: 'cool' as const,
    reverse: false,
    body: [
      'That first breath is always the hardest.',
      'Then something changes.',
      'Cold immersion creates an unmistakable feeling of alertness and energy, which is why it has become such a popular part of modern wellness routines.',
      "For some, it's about starting the morning differently. For others, it's the challenge.",
      'And sometimes it’s simply about proving to yourself that you can.',
    ],
    ritual: ['Breathe.', 'Step in.', 'Stay calm.', 'Step out feeling alive.'],
  },
  {
    id: 'sauna',
    eyebrow: 'Heat',
    heading: 'Sweat. Slow down.<br />Switch off.',
    alt: 'Warm sauna interior with soft light through timber slats',
    variant: 'warm' as const,
    reverse: true,
    body: [
      'Close the door.',
      'Leave the phone outside.',
      'Let the heat do the rest.',
      'Sauna gives you something increasingly difficult to find: a reason to sit still.',
      'Enjoy it alone as part of your routine or turn it into a social ritual with friends and family.',
    ],
  },
  {
    id: 'hot-tub',
    eyebrow: 'Soak',
    heading: 'Connect. Unwind.<br />Stay awhile.',
    alt: 'Steam rising from a wood-fired hot tub as evening falls',
    variant: 'dark' as const,
    reverse: false,
    body: [
      "There's something different about wood-fired heat.",
      'Lighting the fire. Waiting for the water to warm. Watching the steam rise as the evening gets colder.',
      "Our wood-fired hot tubs aren't about rushing.",
      "That's exactly the point.",
    ],
  },
];

const benefitLabels = [
  { icon: 'leaf', label: 'Improved mood' },
  { icon: 'life-buoy', label: 'Better relaxation' },
  { icon: 'flame', label: 'Increased energy' },
  { icon: 'snowflake', label: 'Stress relief' },
  { icon: 'check', label: 'Stronger sense of resilience' },
];
---

<Layout
  title="Benefits"
  description="Hot. Cold. Rest. Repeat. Discover how cold plunge, sauna and wood-fired hot tub rituals help you relax, reset and reconnect."
>
  <Hero
    heading="Feel the difference."
    copy="Hot. Cold. Rest. Repeat."
    imageAlt="Close-up cinematic detail of rippling cold water"
    imageVariant="cool"
    height="tall"
  />

  <section class="section--ivory section--tight">
    <div class="wrap wrap--narrow benefits-intro">
      <h2>Sometimes the simple things<br />feel the best.</h2>
      <p>Warmth. Cold water. Fresh air. A moment away from a screen.</p>
      <p>Our approach to wellness isn't about chasing perfection.</p>
      <p>
        It's about creating time to slow down, challenge yourself, connect
        with others and come away feeling refreshed.
      </p>
    </div>
  </section>

  {modules.map((mod) => (
    <section id={mod.id} class="section--ivory benefit-module">
      <div class="wrap">
        <EditorialSplit imageAlt={mod.alt} imageVariant={mod.variant} reverse={mod.reverse}>
          <p class="eyebrow">{mod.eyebrow}</p>
          <h2 set:html={mod.heading} />
          {mod.body.map((p) => <p>{p}</p>)}
          {mod.ritual && (
            <ul class="mini-ritual">
              {mod.ritual.map((line) => <li>{line}</li>)}
            </ul>
          )}
        </EditorialSplit>
      </div>
    </section>
  ))}

  <section class="section--dark contrast-section">
    <div class="wrap wrap--narrow contrast-inner">
      <h2>Better together.</h2>
      <p class="beats beats--on-dark">Heat. Cold. Rest. Repeat.</p>
      <p>
        Move from the deep warmth of the sauna into cold water before
        allowing your body to rest.
      </p>
      <p>It's simple.</p>
      <p>It's challenging.</p>
      <p>And it can become strangely addictive.</p>
      <p class="contrast-statement">This is the Onda Ritual.</p>
    </div>
    <div class="wrap benefit-labels">
      {benefitLabels.map((b) => (
        <FeatureIcon icon={b.icon} label={b.label} onDark={true}>&nbsp;</FeatureIcon>
      ))}
    </div>
  </section>

  <section class="section--tight section--ivory disclaimer-section">
    <div class="wrap wrap--narrow">
      <p class="disclaimer-text">
        Onda Ritual is about supporting everyday wellbeing and creating
        experiences that help you relax, reset and reconnect. We don't
        believe in miracle cures or wellness hype.
      </p>
      <p class="disclaimer-text">
        If you have a medical condition, are pregnant or have concerns
        about heat or cold exposure, seek appropriate medical advice
        before taking part.
      </p>
    </div>
  </section>

  <section class="section--sand final-cta">
    <div class="wrap final-cta-inner">
      <h2>Ready to start your ritual?</h2>
      <CTAButton href="/at-home/" variant="solid">Explore At-Home Rentals</CTAButton>
    </div>
  </section>
</Layout>

<style>
  .benefits-intro {
    text-align: center;
    margin-inline: auto;
  }

  .benefits-intro h2 {
    margin-inline: auto;
    max-width: 30rem;
  }

  .benefit-module {
    padding-block: 3.5rem;
  }

  .mini-ritual {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    padding-top: 1.2rem;
  }

  .mini-ritual li {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--color-ember);
    line-height: 1.8;
  }

  .contrast-inner {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .contrast-inner h2 {
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .contrast-statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--color-sand);
    margin-top: 1.4rem;
  }

  .benefit-labels {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
    text-align: center;
  }

  .benefit-labels :global(.feature-icon) {
    max-width: none;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .benefit-labels :global(.feature-icon p) {
    display: none;
  }

  .disclaimer-section {
    border-top: 1px solid var(--color-line);
  }

  .disclaimer-text {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .final-cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  @media (max-width: 860px) {
    .benefit-labels {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
