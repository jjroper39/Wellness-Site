---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Vertex Climate for a free quote on air conditioning, heating, servicing or a maintenance plan."
>
  <Hero
    eyebrow="Contact"
    heading="Get a free quote."
    imageAlt="A Vertex Climate engineer preparing for a site visit"
    imageVariant="navy"
    height="tall"
  />

  <section class="section--white contact-section">
    <div class="wrap contact-grid">
      <div class="contact-form-col">
        <p class="contact-intro">
          Tell us what you need and we'll come back to you with a clear,
          itemised quote.
        </p>
        <QuoteForm />
      </div>
      <aside class="contact-details-col">
        <div class="contact-detail-card card">
          <h3>Direct contact</h3>
          <p><Icon name="phone" size={16} /><span class="tbd-inline">[VERTEX PHONE]</span></p>
          <p class="tbd">[VERTEX EMAIL]</p>
          <p><Icon name="map-pin" size={16} /><span class="tbd-inline">[SERVICE AREA]</span></p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-intro {
    max-width: 34rem;
    font-size: 1.05rem;
    color: var(--mid-grey);
    margin-bottom: 2.5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: 3rem;
    align-items: start;
  }

  .contact-detail-card {
    padding: 1.75rem;
    position: sticky;
    top: 6rem;
  }

  .contact-detail-card h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .contact-detail-card p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    margin: 0 0 0.9rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-detail-card {
      position: static;
    }
  }
</style>
