---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Onda Ritual to book a treatment or ask a question."
>
  <section class="intro">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="intro-copy">
        The easiest way to book is by email or phone. Tell us a little about
        what you're looking for and we'll suggest a ritual and a time.
      </p>
    </div>
  </section>

  <section class="details">
    <div class="wrap details-grid">
      <div>
        <h3>Email</h3>
        <p><a href="mailto:hello@ondaritual.co.uk">hello@ondaritual.co.uk</a></p>
      </div>
      <div>
        <h3>Phone</h3>
        <p><a href="tel:+441234567890">+44 (0) 1234 567 890</a></p>
      </div>
      <div>
        <h3>Studio</h3>
        <p>123 High Street<br />United Kingdom</p>
      </div>
      <div>
        <h3>Hours</h3>
        <p>Tuesday &ndash; Saturday<br />10am &ndash; 6pm</p>
      </div>
    </div>
    <a class="button" href="mailto:hello@ondaritual.co.uk">Email us to book</a>
  </section>
</Layout>

<style>
  .intro-copy {
    max-width: 38rem;
    color: var(--color-ink-soft);
  }

  .details {
    background: var(--color-bg-alt);
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .details-grid h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .details-grid a {
    text-decoration: none;
    color: var(--color-accent);
  }

  @media (max-width: 820px) {
    .details-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
