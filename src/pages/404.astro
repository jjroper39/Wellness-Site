---
import Layout from '../layouts/Layout.astro';
import WaveMark from '../components/WaveMark.astro';
import CTAButton from '../components/CTAButton.astro';
---

<Layout title="Page Not Found">
  <section class="section--dark not-found">
    <div class="wrap not-found-inner">
      <WaveMark size={48} class="not-found-mark" />
      <p class="beats beats--on-dark">404</p>
      <h1>We couldn't find that page.</h1>
      <p>It may have moved, or the link might be out of date.</p>
      <CTAButton href="/" onDark={true} variant="solid">Back to Home</CTAButton>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .not-found-inner {
    text-align: center;
    max-width: 28rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .not-found-inner :global(.not-found-mark) {
    color: var(--color-sand);
    margin-bottom: 0.6rem;
  }

  .not-found-inner h1 {
    font-size: 2.2rem;
  }

  .not-found-inner .btn {
    margin-top: 1rem;
  }
</style>
