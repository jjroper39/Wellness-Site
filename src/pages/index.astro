---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTAButton from '../components/CTAButton.astro';
import EditorialSplit from '../components/EditorialSplit.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FullBleedCTA from '../components/FullBleedCTA.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';

const elements = [
  {
    eyebrow: 'Heat',
    heading: 'Slow down. Switch off.',
    copy: 'Step into the warmth of your own sauna or wood-fired hot tub. A space to disconnect from everything else and reconnect with yourself and the people around you.',
    cta: 'Explore Heat',
    href: '/benefits/#sauna',
    variant: 'warm' as const,
    alt: 'Steam rising inside a warm timber sauna interior',
  },
  {
    eyebrow: 'Cold',
    heading: 'Wake up. Reset.',
    copy: "There's nothing quite like it. Cold water. Deep breath. That moment of hesitation followed by the feeling that keeps people coming back.",
    cta: 'Explore Cold',
    href: '/benefits/#cold-plunge',
    variant: 'cool' as const,
    alt: 'Hands touching the rippling surface of cold plunge water',
  },
  {
    eyebrow: 'Restore',
    heading: 'Find your balance.',
    copy: "The magic isn't simply hot or cold. It's the ritual of moving between the two. Heat. Cold. Rest. Then do it all over again.",
    cta: 'Discover the Benefits',
    href: '/benefits/',
    variant: 'dark' as const,
    alt: 'A quiet garden wellness space at dusk, softly lit',
  },
];
---

<Layout
  title="Sauna, Cold Plunge & Wood-Fired Hot Tub Rentals"
  description="Premium sauna, cold plunge and wood-fired hot tub rentals for homes, events, retreats and businesses. Your ritual, delivered."
>
  <Hero
    heading="Your ritual.<br />Delivered."
    copy="Saunas, cold plunges and wood-fired hot tubs, delivered to your home, event or business. Create your own space to switch off, reconnect and feel good — without the commitment of buying your own."
    imageAlt="A wood-fired hot tub and sauna set in a premium garden at dusk, steam rising into cold air"
    imageVariant="dark"
    eyebrow="Heat / Cold / Restore"
    showMark={true}
  >
    <CTAButton href="/at-home/" variant="solid" onDark={true}>Explore At-Home Rentals</CTAButton>
    <CTAButton href="/events-business/" onDark={true}>Events & Business</CTAButton>
  </Hero>

  <section class="section--ivory intro-section">
    <div class="wrap">
      <EditorialSplit imageAlt="Close detail of timber sauna bench and folded linen towels" imageVariant="stone">
        <h2>More than a plunge.<br />More than a sauna.</h2>
        <p class="intro-italic">It's a ritual.</p>
        <p>Hot. Cold. Rest. Repeat.</p>
        <p>
          At Onda Ritual, we make premium wellness experiences accessible
          without the cost or commitment of owning them.
        </p>
        <p>
          From a cold plunge in your garden to a complete sauna and hot tub
          setup, we deliver everything you need to create your own private
          wellness escape.
        </p>
        <p>A weekend. A month. A season.</p>
        <p class="intro-bold">You choose the ritual. We'll bring it to you.</p>
        <CTAButton href="/about/">Discover Onda Ritual</CTAButton>
      </EditorialSplit>
    </div>
  </section>

  <section class="section--dark elements-section">
    <div class="wrap">
      <SectionHeading heading="The Three Elements" align="center" onDark={true} />
      <div class="elements-grid">
        {elements.map((el) => (
          <article class="element-card reveal">
            <ImagePlaceholder alt={el.alt} variant={el.variant} ratio="3 / 4" />
            <div class="element-card-body">
              <p class="eyebrow eyebrow--on-dark">{el.eyebrow}</p>
              <h3>{el.heading}</h3>
              <p>{el.copy}</p>
              <CTAButton href={el.href} onDark={true}>{el.cta}</CTAButton>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section--ivory">
    <div class="wrap">
      <EditorialSplit
        imageAlt="A private garden sauna and cold plunge just steps from a back door"
        imageVariant="warm"
        reverse={true}
      >
        <h2>Your own wellness escape.<br />Just outside your door.</h2>
        <p>Why travel to a spa when the spa can come to you?</p>
        <p>
          Rent our premium saunas, cold plunges and wood-fired hot tubs for
          your home, holiday or special occasion.
        </p>
        <p>
          From weekend escapes to longer-term rentals, we'll deliver and
          set everything up so all you need to do is step outside.
        </p>
        <CTAButton href="/at-home/" variant="solid">Explore At-Home Rentals</CTAButton>
      </EditorialSplit>
    </div>
  </section>

  <section class="section--sand events-business-section">
    <div class="wrap events-business-grid">
      <article class="events-business-panel reveal">
        <ImagePlaceholder alt="Colleagues gathered around a hot tub at a corporate wellness day" variant="warm" ratio="4 / 3" />
        <p class="eyebrow">Events</p>
        <h2>Bring something different.</h2>
        <p>Corporate wellness day? Birthday? Sporting event? Retreat?</p>
        <p>Turn your event into an experience people actually remember.</p>
        <p>
          Choose from individual products or let us create a complete
          hot-and-cold wellness experience for your guests.
        </p>
        <p class="panel-statement">Your event. Your people. Your ritual.</p>
        <CTAButton href="/events-business/#events" variant="solid">Explore Event Packages</CTAButton>
      </article>

      <article class="events-business-panel reveal">
        <ImagePlaceholder alt="A boutique retreat garden with a wood-fired hot tub for guests" variant="cool" ratio="4 / 3" />
        <p class="eyebrow">Business</p>
        <h2>Wellness without the big investment.</h2>
        <p>
          Add a premium wellness experience to your campsite, retreat,
          holiday accommodation or hospitality business without spending
          thousands on purchasing and installing equipment.
        </p>
        <p>
          Flexible seasonal and long-term rental packages allow you to test
          demand, create new revenue and give your guests something worth
          talking about.
        </p>
        <CTAButton href="/events-business/#business-leasing" variant="solid">Explore Business Leasing</CTAButton>
      </article>
    </div>
  </section>

  <FullBleedCTA
    eyebrow="Heat / Cold / Restore"
    heading="Natural rituals.<br />Brighter days."
    variant="olive"
  >
    <CTAButton href="/contact/" variant="solid" onDark={true}>Find Your Ritual</CTAButton>
  </FullBleedCTA>
</Layout>

<style>
  .intro-italic {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-ember);
  }

  .intro-bold {
    font-weight: 600;
    color: var(--color-ink);
  }

  .elements-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .element-card-body {
    padding-top: 1.4rem;
  }

  .element-card-body h3 {
    font-size: 1.4rem;
  }

  .element-card-body p {
    color: #d9d6cc;
  }

  .events-business-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .events-business-panel h2 {
    margin-top: 1.4rem;
    font-size: 1.9rem;
  }

  .panel-statement {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    color: var(--color-ember);
  }

  @media (max-width: 900px) {
    .elements-grid {
      grid-template-columns: 1fr;
      max-width: 26rem;
      margin-inline: auto;
    }

    .events-business-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }
</style>
