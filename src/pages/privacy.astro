---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Privacy Policy" description="How Vertex Climate handles your data.">
  <Hero heading="Privacy Policy" imageAlt="A calm, neutral interior texture" imageVariant="ice" height="tall" />
  <section class="section--white">
    <div class="wrap wrap--narrow">
      <p>
        This page is a placeholder. Your full privacy policy — covering
        what data is collected through the quote form, how it's stored,
        and your rights under UK GDPR — should be added here before the
        site goes live.
      </p>
    </div>
  </section>
</Layout>
