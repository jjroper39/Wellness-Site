---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Terms & Conditions" description="Terms and conditions for Vertex Climate installations and services.">
  <Hero heading="Terms &amp; Conditions" imageAlt="A calm, neutral interior texture" imageVariant="ice" height="tall" />
  <section class="section--white">
    <div class="wrap wrap--narrow">
      <p>
        This page is a placeholder. Your full terms — covering quotes,
        installation, warranties, cancellation and servicing — should be
        added here before the site goes live.
      </p>
    </div>
  </section>
</Layout>
