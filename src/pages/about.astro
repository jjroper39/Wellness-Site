---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CTAButton from '../components/CTAButton.astro';
import EditorialSplit from '../components/EditorialSplit.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FullBleedCTA from '../components/FullBleedCTA.astro';

const values = [
  { label: 'Precise', copy: 'Every system is surveyed and specified properly before any work begins.' },
  { label: 'Dependable', copy: 'We do what we say we’ll do, and support systems after installation.' },
  { label: 'Approachable', copy: 'Straightforward advice, without jargon or pressure.' },
];
---

<Layout
  title="About"
  description="Vertex Climate is a heating and air conditioning specialist for domestic and commercial customers, built around considered specification and dependable aftercare."
>
  <Hero
    eyebrow="About"
    heading="Comfort, engineered."
    copy="Vertex Climate is a modern heating and cooling specialist for domestic and commercial customers."
    imageAlt="A clean, modern building exterior representing a professional engineering business"
    imageVariant="navy"
    height="tall"
  />

  <section class="section--white">
    <div class="wrap">
      <EditorialSplit imageAlt="An engineer carefully specifying a heating and cooling installation" imageVariant="ice">
        <p class="eyebrow">Our approach</p>
        <h2>Engineered, not guessed.</h2>
        <p>
          Heating and cooling systems are easy to get wrong — oversized,
          undersized, or specified without much thought for how a space is
          actually used.
        </p>
        <p>
          We take a more considered approach: survey the property, specify
          a system that fits, install it cleanly, and stay available for
          servicing and support afterwards.
        </p>
        <p>
          That's the idea behind the name — <strong>Vertex</strong>, the
          point where precision and comfort meet.
        </p>
        <CTAButton href="/contact/">Get a Free Quote</CTAButton>
      </EditorialSplit>
    </div>
  </section>

  <section class="section--ice">
    <div class="wrap values-inner">
      <SectionHeading heading="What we value" align="center" />
      <div class="values-grid">
        {values.map((v) => (
          <div class="value-item reveal">
            <h3>{v.label}</h3>
            <p>{v.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FullBleedCTA heading="Ready for better comfort?">
    <CTAButton href="/contact/" onDark={true}>Get a Free Quote</CTAButton>
  </FullBleedCTA>
</Layout>

<style>
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .value-item {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 1.75rem;
  }

  .value-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .value-item p {
    color: var(--mid-grey);
    font-size: 0.94rem;
    margin: 0;
  }

  @media (max-width: 860px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
